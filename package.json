{
  "name": "genfixs-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter '!@genfixs/web' typecheck && pnpm --filter @genfixs/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "demo": "pnpm --filter @genfixs/api demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
